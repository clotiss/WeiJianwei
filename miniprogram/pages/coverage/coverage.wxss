.container { padding: 18px 14px 36px; }
.page-title { font-size: 23px; font-weight: 600; color: #203d53; margin-bottom: 14px; }
.source { background: #fff; border: 1px solid #e3eaf0; padding: 16px; border-radius: 12px; margin: 12px 0; }
.source-heading { color: #203d53; font-size: 16px; font-weight: 600; }
.source-name { color: #63798a; font-size: 12px; margin-top: 8px; }
.source-status { color: #1a6fb5; font-size: 12px; margin-top: 10px; }
.source-date { color: #697d8e; font-size: 11px; margin-top: 6px; }
