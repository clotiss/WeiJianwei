<view class="container">
  <view class="page-title">内容来源</view>
  <view class="scope-note">政策与解读来自以下官方网站，可在文章详情中查看官方原文。</view>
  <view wx:if="{{loading}}" class="page-loading">加载中…</view>
  <view wx:elif="{{loadError}}" class="inline-error" bindtap="fetchCoverage">{{errorText}} · 点击重试</view>
  <block wx:else>
    <view wx:if="{{!sources.length}}" class="page-loading">暂无来源信息</view>
    <view class="source" wx:for="{{sources}}" wx:key="id">
      <view class="source-heading">{{item.regionName}} · {{item.kind}}</view>
      <view class="source-name">{{item.name}}</view>
      <view class="source-date">可查阅 {{item.documents}} 篇</view>
    </view>
  </block>
</view>
