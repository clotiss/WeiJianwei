.follow-group { background:white; border:1px solid #e4ebee; border-radius:9px; margin:15px 0; overflow:hidden; }.follow-row { display:flex; align-items:center; gap:12px; padding:15px; border-bottom:1px solid #edf1f3; }.follow-row:last-child { border:0; }.follow-row.selected { background:#f7fafc; }.follow-icon { width:33px; height:33px; display:flex; align-items:center; justify-content:center; background:#edf5f7; border-radius:9px; flex-shrink:0; }.follow-main { flex:1; }.follow-title { font-size:12px; font-weight:550; }.follow-desc { font-size:10px; color:#82949f; margin-top:3px; }.unfollow { border:1px solid #b9d1df; background:#eef5f9; color:#326e9b; padding:5px 8px; border-radius:5px; font-size:10px; white-space:nowrap; flex-shrink:0; }
.add-group { padding:15px; }.group-title { font-size:12px; font-weight:600; margin-bottom:12px; }.selectors { display:flex; gap:8px; }.selectors picker { min-width:0; flex:1; }.selector { display:flex; align-items:center; justify-content:space-between; gap:8px; font-size:11px; color:#526a78; padding:9px; border:1px solid #e4ebee; border-radius:6px; }.selector image { width:12px; height:12px; flex-shrink:0; }.include-row { display:flex; justify-content:space-between; align-items:center; margin:12px 0; color:#697b87; font-size:11px; }

.push-card { padding:15px; }.push-description { font-size:12px; color:#526a78; line-height:1.8; }.push-hint { font-size:11px; color:#82949f; margin:8px 0 14px; line-height:1.8; }.push-remaining { color:#187c80; font-size:12px; margin:10px 0; }.push-pause { background:transparent; color:#697b87; font-size:11px; margin-top:8px; padding:7px; }
