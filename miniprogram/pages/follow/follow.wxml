<view class="app-content">
  <view class="app-title-row"><view class="app-title">我的关注</view><view class="region-button" bindtap="refreshRules"><image class="icon" src="/assets/icons/refresh-muted.png"/>同步</view></view>
  <view class="scope-note">把关心的地区和主题，变成自己的信息清单。</view>
  <view class="follow-group add-group"><view class="group-title">添加关注</view><view class="selectors"><picker range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="regionChanged"><view class="selector">{{regions[regionIndex].name}}<image src="/assets/icons/down-muted.png"/></view></picker><picker range="{{topics}}" value="{{topicIndex}}" bindchange="topicChanged"><view class="selector">{{topics[topicIndex]}}<image src="/assets/icons/down-muted.png"/></view></picker></view><view class="include-row"><text>同时包含国家级文件</text><switch color="#2269b0" checked="{{includeNational}}" bindchange="nationalChanged"/></view><button class="app-button secondary" bindtap="addRule" loading="{{busy}}" disabled="{{busy || dictError}}">＋ 关注此范围</button></view>
  <view wx:if="{{dictError}}" class="inline-error" bindtap="loadDictionaries">地区或主题加载失败 · 点击重试</view><view wx:if="{{accountError}}" class="inline-error">{{accountError}}</view>
  <view class="follow-group push-card" wx:if="{{loggedIn && rules.length}}">
    <view class="group-title">新文件提醒</view>
    <view class="push-description">每日 9:00 汇总关注范围内的新文件，有更新时通过微信服务通知提醒你。</view>
    <block wx:if="{{pushState.available}}">
      <view class="push-hint">每次同意订阅可接收一条汇总提醒，发送后可再次订阅。</view>
      <view wx:if="{{pushState.enabled && pushState.credits > 0}}" class="push-remaining">已开启 · 可接收 {{pushState.credits}} 次提醒</view>
      <view wx:elif="{{pushSaved}}" class="push-remaining">提醒设置已保存</view>
      <button class="app-button" bindtap="enablePush" loading="{{pushBusy}}" disabled="{{pushBusy || !pushGrant}}">{{pushState.enabled && pushState.credits > 0 ? '再订阅一次提醒' : '开启微信提醒'}}</button>
      <button wx:if="{{pushState.enabled}}" class="push-pause" bindtap="disablePush" disabled="{{pushBusy}}">暂停提醒</button>
    </block>
    <view wx:else class="push-hint">微信提醒暂未开放，可先在这里查看关注内容。</view>
    <view wx:if="{{pushError}}" class="inline-error" bindtap="refreshPush">{{pushError}}</view>
  </view>
  <view class="list-label"><text class="label-title">{{loggedIn ? '已关注 ' + rules.length + ' 项' : '登录后同步关注'}}</text><text>点击查看相关政策</text></view>
  <view class="follow-group" wx:if="{{rules.length}}"><view wx:for="{{rules}}" wx:key="id" class="follow-row {{activeId === item.id ? 'selected' : ''}}"><view class="follow-icon"><image class="icon" src="/assets/icons/bell-blue.png"/></view><view class="follow-main" data-id="{{item.id}}" bindtap="selectRule"><view class="follow-title">{{item.label}}</view><view class="follow-desc">{{activeId === item.id ? '当前查看' : '查看此范围'}}</view></view><button class="unfollow" disabled="{{busy}}" data-id="{{item.id}}" bindtap="removeRule">已关注</button></view></view>
  <view wx:if="{{!rules.length && !busy}}" class="empty-state"><image class="empty-icon" src="/assets/icons/bell-muted.png"/><view class="empty-title">还没有关注内容</view><view class="empty-description">先选择一个地区或主题，查看相关政策。</view></view>
  <block wx:if="{{rules.length}}"><view class="list-label"><text class="label-title">与你相关的政策</text><text>按发布日期排序</text></view><view wx:if="{{loadError}}" class="inline-error" bindtap="fetchList">{{errorText}} · 点击重试</view><file-card wx:for="{{documents}}" wx:key="id" doc="{{item}}"/><view wx:if="{{loading}}" class="load-end">加载中…</view><view wx:elif="{{hasMore}}" class="load-end" bindtap="loadMore">加载更多</view><view wx:elif="{{!loadError && !documents.length}}" class="load-end">当前关注范围暂无政策</view></block>

</view>
