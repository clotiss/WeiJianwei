.profile-head { display:flex; align-items:center; gap:13px; margin:12px 0 25px; }.avatar { width:49px; height:49px; border-radius:16px; background:#e5eef4; color:#49718e; display:flex; align-items:center; justify-content:center; font-size:22px; }.profile-title { font-size:18px; font-weight:650; }.profile-note { color:#82949f; font-size:11px; margin-top:5px; }
.profile-stats { display:flex; margin:22px 0; }.profile-stats>view { flex:1; text-align:center; color:#728793; font-size:11px; border-right:1px solid #e4ebee; }.profile-stats>view:last-child { border:0; }.stat-number { display:block; font-size:23px; color:#244961; line-height:1.7; font-weight:600; }
.settings-group { margin:25px 0; background:white; border:1px solid #e4ebee; border-radius:9px; overflow:hidden; }.settings-row { display:flex; align-items:center; justify-content:space-between; padding:16px 15px; border-bottom:1px solid #edf1f3; font-size:12px; }.settings-row:last-child { border:0; }.settings-row>view { display:flex; align-items:center; gap:10px; }.settings-row>image { width:15px; height:15px; }
.history-row { background:white; border:1px solid #e4ebee; padding:13px; border-radius:7px; font-size:12px; margin:8px 0; color:#435d70; }
