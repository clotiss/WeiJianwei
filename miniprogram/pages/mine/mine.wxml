<view class="app-content">
  <view class="profile-head"><view class="avatar">{{loggedIn ? '我' : '访'}}</view><view><view class="profile-title">{{loggedIn ? '你好，欢迎回来' : '你好，访客'}}</view><view class="profile-note">{{loggedIn ? '收藏与关注，随时回来查看。' : '先浏览感兴趣的内容，需要时再登录。'}}</view></view></view>
  <view class="profile-stats"><view bindtap="goFavorites"><text class="stat-number">{{favoriteCount}}</text><text>我的收藏</text></view><view bindtap="goFollow"><text class="stat-number">{{followCount}}</text><text>我的关注</text></view><view bindtap="toggleHistory"><text class="stat-number">{{historyCount}}</text><text>浏览记录</text></view></view>
  <button wx:if="{{!loggedIn}}" class="app-button secondary" bindtap="login" loading="{{busy}}" disabled="{{busy}}">登录后同步收藏与关注</button>
  <view wx:if="{{errorText}}" class="inline-error">{{errorText}}</view>
  <view class="settings-group"><view class="settings-row" bindtap="goFavorites"><view><image class="icon" src="/assets/icons/book-muted.png"/>我的收藏</view><image class="icon" src="/assets/icons/chevron-muted.png"/></view><view class="settings-row" bindtap="goFollow"><view><image class="icon" src="/assets/icons/bell-muted.png"/>关注与站内更新</view><image class="icon" src="/assets/icons/chevron-muted.png"/></view><view class="settings-row"><view><image class="icon" src="/assets/icons/settings-muted.png"/>大字正文</view><switch color="#2269b0" checked="{{largeText}}" bindchange="changeReading"/></view><view class="settings-row" bindtap="goCoverage"><view><image class="icon" src="/assets/icons/policy-muted.png"/>数据覆盖说明</view><image class="icon" src="/assets/icons/chevron-muted.png"/></view></view>
  <view wx:if="{{showHistory}}"><view class="list-label"><text class="label-title">最近浏览 · 保存在本机</text></view><view wx:for="{{history}}" wx:key="id" class="history-row" data-id="{{item.id}}" bindtap="openHistory">{{item.title}}</view><view wx:if="{{!history.length}}" class="load-end">还没有浏览记录</view></view>
  <view class="load-end"><view>卫健政策速查</view><view>原文有据，信息有序</view></view>
</view>
