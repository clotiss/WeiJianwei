<view class="container" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{loadError}}" class="inline-error" bindtap="fetchDetail">{{errorText}} · 点击重试</view>
  <block wx:else>
    <view class="title-row"><view class="title">{{doc.title}}</view></view>
    <view class="meta" wx:if="{{doc.doc_number}}">文号：{{doc.doc_number}}</view>
    <view class="meta">发布日期：{{doc.publish_date || '未标注'}}</view>
    <view class="meta">发布机构：{{doc.issuing_authority || '未标注，请以原文为准'}}</view>
    <view class="meta" wx:if="{{doc.region_name}}">官网来源地区：{{doc.region_name}}</view>
    <view class="meta">{{doc.category || '待分类'}} · {{doc.doc_type}}</view>
    <button class="favorite-action" loading="{{favBusy}}" disabled="{{favBusy}}" bindtap="toggleFav">{{favBusy ? '同步中' : (favKnown && isFav ? '★ 已收藏 · 点击取消' : '☆ 收藏文件')}}</button>
    <view wx:if="{{favError}}" class="inline-error" bindtap="retryFavorite">{{favError}}</view>
    <view class="section" wx:if="{{summary.length}}">
      <view class="section-title">关键内容</view>
      <view class="summary-box"><view wx:for="{{summary}}" wx:key="index" class="summary-item"><text class="summary-num">{{index + 1}}</text><text>{{item}}</text></view></view>
      <view class="scope-note">辅助阅读摘要，具体要求请以官网原文为准</view>
    </view>
    <view class="btn-original" bindtap="openPlaintext">阅读已收录正文</view>
    <view class="btn-original secondary" wx:if="{{doc.original_url}}" bindtap="openOriginal">复制官网原文链接</view>
    <view class="section" wx:if="{{attachments.length}}">
      <view class="section-title">附件（{{attachments.length}}）</view>
      <view wx:for="{{attachments}}" wx:key="index" class="attach-item" bindtap="openAttachment" data-url="{{item.url}}"><view>{{item.name || '附件'}}</view><view class="attachment-note">{{item.statusLabel}} · 复制官网链接</view></view>
    </view>
  </block>
</view>
