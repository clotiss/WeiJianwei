<view class="detail-content">
  <view wx:if="{{loading}}" class="page-loading">加载中…</view>
  <view wx:elif="{{loadError}}" class="inline-error" bindtap="fetchDetail">{{errorText}} · 点击重试</view>
  <block wx:else>
    <view class="detail-kicker"><text wx:if="{{doc.region_name}}" class="tag">{{doc.region_name}}</text><text>{{doc.type_label || doc.doc_type}}</text><text>·</text><text>{{doc.category || '待分类'}}</text></view>
    <view class="detail-title">{{doc.title}}</view>
    <view class="detail-meta"><view>{{doc.issuing_authority || '发布机构未标注，请以原文为准'}}</view><view>发布于 {{doc.publish_date || '日期未标注'}}</view><view wx:if="{{doc.doc_number}}">{{doc.doc_number}}</view></view>
    <view class="source-box"><image class="icon" src="/assets/icons/shield-teal.png"/><view class="source-text"><view>来源有记录 · 阅读有依据</view><view class="source-sub">{{doc.region_name ? '官网来源：' + doc.region_name : '以官网原文为准'}}</view></view><view class="source-link" wx:if="{{doc.original_url}}" bindtap="openOriginal">查看来源</view></view>
    <view class="app-tabs"><view class="app-tab {{activeTab === '要点' ? 'active' : ''}}" data-tab="要点" bindtap="selectTab">要点</view><view class="app-tab {{activeTab === '正文' ? 'active' : ''}}" data-tab="正文" bindtap="selectTab">正文</view><view class="app-tab {{activeTab === '附件' ? 'active' : ''}}" data-tab="附件" bindtap="selectTab">附件{{attachments.length ? ' · ' + attachments.length : ''}}</view></view>
    <block wx:if="{{activeTab === '要点'}}">
      <view class="summary-box" wx:if="{{summary.length}}">
        <view class="summary-label"><image class="icon" src="/assets/icons/spark-blue.png"/><text>AI 快速读懂</text><text class="summary-hint">辅助摘要 · 以原文为准</text></view>
        <view wx:if="{{summaryView.scope}}" class="summary-scope">{{summaryView.scope}}</view>
        <view class="summary-item" wx:for="{{summary}}" wx:key="index">
          <view class="point"><text class="point-no">{{index + 1 < 10 ? '0' + (index + 1) : index + 1}}</text><text>{{item.text}}</text></view>
          <view wx:if="{{item.quote}}" class="evidence-toggle" bindtap="toggleEvidence" data-index="{{index}}">{{item.expanded ? '收起原文依据 −' : '查看原文依据 +'}}</view>
          <view wx:if="{{item.quote && item.expanded}}" class="evidence-box"><view class="evidence-source">{{item.source_name || '正文'}}{{item.location.page ? ' · 第' + item.location.page + '页' : ''}}</view><text selectable>{{item.quote}}</text></view>
        </view>
      </view>
      <view wx:else class="summary-box"><view class="summary-label">{{summaryView.title}}</view><view class="scope-note">{{summaryView.note}}</view><view wx:if="{{summaryError}}" class="summary-error">{{summaryError}}</view><button wx:if="{{summaryView.refresh}}" class="app-button secondary" loading="{{summaryRefreshing}}" disabled="{{summaryRefreshing}}" bindtap="refreshSummary">刷新要点</button><button class="app-button secondary summary-read" bindtap="showBody">阅读正文</button></view>
    </block>
    <view wx:elif="{{activeTab === '正文'}}" class="body-section"><view class="scope-note">以下为已收录正文，具体要求以官网发布内容为准。</view><text class="article-body {{largeText ? 'large' : ''}}" selectable>{{doc.content || '暂未收录正文，请查看官方来源。'}}</text><button class="app-button secondary reader-link" bindtap="openPlaintext">全屏阅读</button></view>
    <view wx:else class="detail-section"><view wx:if="{{!attachments.length}}" class="scope-note">本篇未收录附件，可查看官网原文核对。</view><view wx:for="{{attachments}}" wx:key="index" class="attachment" bindtap="openAttachment" data-url="{{item.url}}"><view class="attachment-icon">FILE</view><view class="attachment-info"><view>{{item.name || '附件'}}</view></view><text class="attachment-link">复制链接</text></view><view wx:if="{{attachments.length}}" class="scope-note">复制官网附件链接后，可在浏览器中打开。</view></view>
    <view wx:if="{{favError}}" class="inline-error" bindtap="retryFavorite">{{favError}}</view>
  </block>
</view>
<view class="detail-actions" wx:if="{{!loading && !loadError}}"><button class="app-button secondary favorite-action" loading="{{favBusy}}" disabled="{{favBusy}}" bindtap="toggleFav"><image class="icon" src="/assets/icons/book-blue.png"/>{{favKnown && isFav ? '已收藏' : '收藏'}}</button><button class="app-button" disabled="{{!doc.original_url}}" bindtap="openOriginal"><image class="icon" src="/assets/icons/link-white.png"/>查看官方来源</button></view>
