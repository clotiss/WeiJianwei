page { background:white; }
.detail-content { padding:20px 19px calc(95px + env(safe-area-inset-bottom)); }
.detail-kicker { display:flex; align-items:center; gap:7px; color:#5d7c91; font-size:10px; margin-bottom:12px; flex-wrap:wrap; }
.detail-title { font-size:22px; line-height:1.6; font-weight:650; letter-spacing:-.4px; margin-bottom:14px; }
.detail-meta { font-size:11px; color:#80919b; line-height:1.9; margin-bottom:15px; }
.source-box { background:#f3f7f8; border-radius:7px; padding:10px 12px; display:flex; align-items:center; gap:10px; color:#57707f; font-size:11px; margin-bottom:20px; }
.source-text { flex:1; } .source-sub { font-size:10px; } .source-link { font-size:10px; color:#2269b0; white-space:nowrap; padding:5px; }
.summary-box { background:#eff5fa; padding:16px; border-radius:9px; margin-top:18px; }
.summary-label { display:flex; align-items:center; gap:6px; color:#3e6f97; font-size:11px; margin-bottom:14px; font-weight:600; }
.summary-hint { font-size:9px; font-weight:400; color:#7893a8; margin-left:auto; }
.point { display:flex; gap:10px; font-size:12px; line-height:1.9; color:#3d586a; margin-bottom:13px; }.point:last-child { margin-bottom:0; }.point-no { color:#6697bc; font-size:10px; line-height:23px; flex-shrink:0; }
.detail-section { margin-top:22px; }.section-title { font-size:13px; font-weight:600; margin-bottom:12px; }.record-row { border:1px solid #e2e9ed; border-radius:7px; padding:12px; font-size:11px; color:#3d586a; }.record-row text { margin-left:10px; font-size:10px; color:#82949f; }
.body-section { margin-top:20px; }.article-body { font-size:14px; line-height:2; color:#435d70; white-space:pre-wrap; word-break:break-all; }.article-body.large { font-size:18px; }.reader-link { margin-top:24px; }
.attachment { border:1px solid #e1e9ed; padding:13px; border-radius:8px; display:flex; gap:10px; margin:14px 0; align-items:center; }.attachment-icon { background:#e9f0f8; color:#3773a5; border-radius:5px; padding:9px; font-size:9px; font-weight:650; }.attachment-info { flex:1; font-size:11px; line-height:1.7; word-break:break-all; }.attachment-info text { display:block; font-size:9px; color:#697b87; }.attachment-link { color:#2269b0; font-size:10px; flex-shrink:0; }
.detail-actions { position:fixed; bottom:0; left:0; width:100%; display:flex; gap:9px; padding:11px 17px calc(14px + env(safe-area-inset-bottom)); border-top:1px solid #e4ebee; background:white; }.detail-actions .app-button { flex:1; }.detail-actions .favorite-action { flex:.7; }
