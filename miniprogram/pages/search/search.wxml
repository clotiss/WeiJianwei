<view class="container" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <view class="search-bar">
    <view class="back" bindtap="goBack">←</view>
    <input class="search-input" placeholder="输入关键词搜索" focus="{{true}}" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" confirm-type="search" />
    <view class="search-action" bindtap="onSearch">搜索</view>
  </view>
  <view class="scope-note">搜索范围：{{scope}}</view>
  <view class="result-count" wx:if="{{searched && !loading && !loadError}}">“{{query}}” 找到 {{total}} 条结果</view>
  <view class="inline-error" wx:if="{{loadError}}" bindtap="doSearch">{{errorText}} · 点击重试</view>
  <file-card wx:for="{{results}}" wx:key="id" doc="{{item}}" />
  <view wx:if="{{loading}}" class="page-loading">搜索中…</view>
  <view wx:elif="{{searched && !loadError && !results.length}}" class="empty">暂无匹配结果，试试其他关键词或筛选范围</view>
  <view wx:elif="{{hasMore}}" class="load-more" bindtap="loadMore">加载更多</view>
  <view wx:if="{{!searched}}" class="page-loading">输入关键词，在当前范围内查找政策</view>
</view>
