<view class="container">
  <view class="intro" wx:if="{{useV2}}">
    <view class="eyebrow">卫生健康 · 政策资料</view>
    <view class="intro-title">关注你所在地区的政策</view>
    <view class="intro-note">按官网来源筛选，发布机构与适用范围请以原文为准</view>
  </view>
  <view class="top-bar">
    <view class="search-box" bindtap="goSearch"><text class="search-icon">⌕</text><text class="search-placeholder">{{useV2 ? '搜索标题、文号、正文' : '搜索标题、发文机构'}}</text></view>
    <view class="fav-btn" bindtap="goFavorites">我的收藏</view>
  </view>
  <view class="region-panel" wx:if="{{useV2}}">
    <view class="region-row">
      <picker mode="selector" range="{{regions}}" range-key="name" value="{{regionIndex}}" bindchange="onRegionChange" disabled="{{regionsLoading || regionsError}}">
        <view class="region-picker">{{regionsLoading ? '加载地区…' : regions[regionIndex].name}} <text class="chevron">⌄</text></view>
      </picker>
      <view class="coverage-link" bindtap="goCoverage">来源与更新 ›</view>
    </view>
    <view class="national-toggle" wx:if="{{activeRegion && activeRegion !== 'CN'}}">
      <text>同时查看国家级文件</text><switch checked="{{includeNational}}" bindchange="onNationalChange" color="#1a6fb5" />
    </view>
    <view class="inline-error" wx:if="{{regionsError}}" bindtap="fetchRegions">地区加载失败，点击重试</view>
  </view>
  <view class="inline-error" wx:if="{{categoriesError}}" bindtap="fetchCategories">分类加载失败，点击重试</view>
  <scroll-view class="category-scroll" scroll-x enable-flex>
    <view class="category-rows">
      <view class="category-row"><view wx:for="{{categoryRow1}}" wx:key="*this" class="tag {{activeCategory === item ? 'tag-active' : ''}}" bindtap="onCategoryTap" data-category="{{item}}">{{item}}</view></view>
      <view class="category-row"><view wx:for="{{categoryRow2}}" wx:key="*this" class="tag {{activeCategory === item ? 'tag-active' : ''}}" bindtap="onCategoryTap" data-category="{{item}}">{{item}}</view></view>
    </view>
  </scroll-view>
  <view class="type-bar"><view wx:for="{{docTypes}}" wx:key="*this" class="type-item {{activeType === item ? 'type-active' : ''}}" bindtap="onTypeTap" data-type="{{item}}">{{item}}</view></view>
  <view class="update-time" wx:if="{{latestUpdate}}">当前范围最新发布：{{latestUpdate}}</view>
  <view class="update-time" wx:if="{{collectionUpdate}}">最近一轮采集完成：{{collectionUpdate}}</view>
  <view class="status-note" wx:if="{{updateNotice}}">{{updateNotice}}</view>
  <view class="inline-error" wx:if="{{loadError}}" bindtap="retryDocuments">{{documents.length ? '更新失败，已保留内容' : errorText}} · 点击重试</view>
  <skeleton wx:if="{{loading && !documents.length}}" count="{{4}}" />
  <view wx:else>
    <file-card wx:for="{{documents}}" wx:key="id" doc="{{item}}" />
    <view wx:if="{{!documents.length && !loadError}}" class="empty">
      <view>当前筛选下暂无已收录文件</view>
      <view class="empty-hint">可切换地区或分类；未收录不代表官网没有发布</view>
    </view>
    <view wx:if="{{loading}}" class="load-more">正在加载…</view>
    <view wx:elif="{{hasMore && documents.length}}" class="load-more" bindtap="loadMore">加载更多</view>
    <view wx:elif="{{documents.length}}" class="update-time end-note">已显示当前范围全部 {{total}} 条</view>
    <view wx:if="{{documents.length}}" class="view-more" bindtap="goCategory">查看筛选结果 →</view>
  </view>
  <view class="future-entry" wx:if="{{useV2}}"><text>医疗招聘</text><text class="future-label">筹备中 · 后续开放</text></view>
  <movable-area class="float-area" wx:if="{{!useV2}}">
    <movable-view class="float-btn {{floatBtnMoving ? 'float-btn--moving' : ''}}" direction="all" x="{{floatBtnX}}" y="{{floatBtnY}}" bindtap="onFloatBtnTap" bindchange="onFloatBtnMove" bindtouchend="onFloatBtnEnd" damping="{{40}}"><text class="float-btn-icon">🤖</text></movable-view>
  </movable-area>
  <agent-chat wx:if="{{!useV2}}" show="{{showChat}}" bind:close="onChatClose" />
</view>
