.search-box { display:flex; align-items:center; gap:9px; background:#eef2f4; border:1px solid transparent; border-radius:9px; height:43px; padding:10px 12px; margin-bottom:15px; color:#81929e; font-size:12px; }
.search-box .icon { width:17px; height:17px; }
.filter-strip { display:flex; align-items:center; gap:8px; margin:14px 0; }
.pill { font-size:10px; padding:5px 9px; border:1px solid #e0e7eb; border-radius:5px; background:white; white-space:nowrap; color:#617785; }
.pill.active { background:#e6eff8; border-color:#c5d8e8; color:#24629c; }
.pill.filter { margin-left:auto; display:flex; gap:4px; align-items:center; }
.pill image { width:12px; height:12px; }
.briefing { background:#e8f2f2; border-radius:9px; padding:15px 14px; margin-bottom:19px; display:flex; justify-content:space-between; gap:10px; align-items:center; }
.briefing-title { font-size:13px; font-weight:600; color:#24575e; }
.briefing-note { font-size:10px; color:#5d7b80; margin-top:5px; }
.briefing-arrow { background:#ffffffad; border-radius:50%; width:29px; height:29px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.load-more { padding:16px 0; text-align:center; color:#2269b0; font-size:12px; }
.coverage-link { text-align:right; }
