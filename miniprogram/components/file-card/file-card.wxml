<view class="file-card" bindtap="onTap">
  <view class="badges" wx:if="{{doc.region_name}}"><text class="region">{{doc.region_name}}</text><text class="kind">{{doc.doc_type}}</text></view>
  <view class="title">{{doc.title}}</view>
  <view class="authority" wx:if="{{doc.issuing_authority}}">{{doc.issuing_authority}}</view>
  <view class="meta"><text wx:if="{{doc.doc_number}}">{{doc.doc_number}} · </text><text>{{doc.publish_date || '日期未标注'}}</text></view>
</view>
