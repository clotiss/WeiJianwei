.policy-card { background:#fff; border:1px solid #e6ecef; border-radius:10px; margin-bottom:11px; overflow:hidden; }
.card-open { padding:14px 14px 10px; }
.card-meta { display:flex; align-items:center; gap:6px; font-size:9px; color:#7c8f9a; margin-bottom:8px; }
.region-label { color:#54758d; background:#f0f5f8; border-radius:3px; padding:1px 5px; flex-shrink:0; }
.authority { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.type { margin-left:auto; color:#4f8b82; white-space:nowrap; flex-shrink:0; }
.card-title { font-size:14px; line-height:1.65; font-weight:620; color:#172b3a; margin-bottom:8px; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
.card-summary { font-size:11px; color:#798a96; line-height:1.8; margin-bottom:6px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.card-footer { display:flex; align-items:center; gap:6px; padding:0 14px 10px; font-size:9px; color:#8898a2; }
.tag { color:#6b8597; font-size:9px; background:#f1f5f7; padding:2px 5px; border-radius:3px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:52%; }
.date { margin-left:auto; font-variant-numeric:tabular-nums; white-space:nowrap; }
.bookmark { background:transparent; display:flex; align-items:center; justify-content:center; margin:0 -5px 0 0; padding:6px; width:28px; height:28px; line-height:1; }
.bookmark::after { border:0; } .bookmark image { width:15px; height:15px; }

button.bookmark { min-width:0; max-width:28px; flex:0 0 28px; width:28px; margin:0; }
